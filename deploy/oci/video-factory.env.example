# Copy to /etc/video-factory/video-factory.env and keep mode 0600.
# This file is read by systemd and by the administrative helper scripts.

VIDEO_FACTORY_APP_ROOT=/opt/video-factory/app
VIDEO_FACTORY_WORKSPACE=/srv/video-factory/workspace
VIDEO_FACTORY_RUNTIME=/srv/video-factory/runtime
VIDEO_FACTORY_CLI=/opt/video-factory/venv/bin/video-factory

MPT_ROOT=/opt/video-factory/MoneyPrinterTurbo
MPT_PYTHON=/opt/video-factory/MoneyPrinterTurbo/.venv/bin/python
WEB_SCROLL_VIDEO_ROOT=/opt/video-factory/web-scroll-video

VIDEO_FACTORY_SAU_HOME=/srv/video-factory/runtime/social-auto-upload
VIDEO_FACTORY_YOUTUBE_RUNTIME_HOME=/srv/video-factory/runtime/youtube
VIDEO_FACTORY_INSTALL_YOUTUBE_RUNTIME=0
VIDEO_FACTORY_INSTALL_MANAGED_CHROMIUM=1
VIDEO_FACTORY_CHROME_PATH=/opt/video-factory/bin/chromium
CHROME_PATH=/opt/video-factory/bin/chromium

VIDEO_FACTORY_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
VIDEO_FACTORY_BGM_FILE=/srv/video-factory/workspace/assets/music/858ccdf31193/better-times-are-coming-mixkit-173.mp3
VIDEO_FACTORY_FFMPEG_PRESET=medium

# The server-safe phase-one set deliberately excludes X. The current X input
# adapter expects OpenCLI connected to an existing desktop Chrome extension.
VIDEO_FACTORY_DISCOVERY_CONFIG=/opt/video-factory/app/examples/resource_discovery.json
VIDEO_FACTORY_DISCOVERY_PROVIDER=auto
VIDEO_FACTORY_DISCOVERY_CHANNELS=github,official,paper,news,openrouter

VIDEO_FACTORY_BACKUP_DIR=/srv/video-factory/backups
VIDEO_FACTORY_BACKUP_RETENTION_DAYS=14
VIDEO_FACTORY_BACKUP_INCLUDE_FINALS=0
# Optional: install/configure OCI CLI, then set both values to copy archives to
# Always Free Object Storage. Cookies and browser profiles are never included.
OCI_BACKUP_BUCKET=
OCI_BACKUP_NAMESPACE=

# Add only the provider credentials you use. Never commit real values.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
KIMI_API_KEY=
KIMI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GITHUB_TOKEN=
VIDEO_FACTORY_YOUTUBE_PO_TOKEN=
